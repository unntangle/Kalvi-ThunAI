# Copy this file to .env.local and fill in the values.
#
# YouTube Data API v3 key. Without it the video tab falls back to a search link
# and a paste field instead of playing automatically.
# Create one at https://console.cloud.google.com -> APIs & Services -> Credentials,
# with the YouTube Data API v3 enabled. Restrict the key to that API.
YOUTUBE_API_KEY=

# Optional. Restrict every lookup to one channel, for example KalviTV Official.
# Leave blank to search all of YouTube.
YOUTUBE_CHANNEL_ID=

# Anthropic key for the ask-a-doubt chat on the concept page. Without it the chat
# still works, answering from the concept's own material instead of from a model.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=
